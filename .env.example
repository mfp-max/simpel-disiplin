# Salin menjadi .env.local lalu isi. JANGAN commit nilai asli.

# Postgres Supabase lewat connection pooler MODE SESI (port 5432) — dipakai aplikasi.
# Jangan mode transaksi (6543): kueri berparameter bisa macet (lihat lib/db.ts).
DATABASE_URL=postgresql://simpel_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Mode sesi (port 5432) — dipakai skrip migrasi
DATABASE_URL_MIGRASI=postgresql://simpel_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (kunci service_role — hanya server)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/masuk
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/daftar

# Pengaman cron Vercel
CRON_SECRET=

# Opsional: API Simpega (biarkan kosong bila belum tersedia)
SIMPEGA_API_URL=
SIMPEGA_API_KEY=
